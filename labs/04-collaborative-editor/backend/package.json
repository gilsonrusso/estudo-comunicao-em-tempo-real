{
  "name": "lab-04-collaborative-editor-backend",
  "version": "1.0.0",
  "description": "Backend Fastify com TypeScript, Zod type-provider e WebSocket para edição colaborativa",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.4",
    "@fastify/websocket": "^11.0.2",
    "adm-zip": "^0.6.1",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  }
}
